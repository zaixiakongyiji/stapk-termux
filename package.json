{
  "name": "stapk-termux",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test:no-node": "node --test test/no-node/*.test.mjs",
    "scan:no-node-contract": "node scripts/stapk-scan-web-contract.mjs --web-root build/stapk-no-node/upstream/public --out build/no-node-payload/api-contract.json --allowlist transform/no-node/mvp-api-allowlist.json --capabilities transform/no-node/capabilities.json --upstream-ref release",
    "transform:no-node": "node scripts/stapk-transform-no-node.mjs --ref release --out build/no-node-payload --android-assets mobile/app/src/main/assets --clean",
    "transform:no-node:verify": "node scripts/stapk-verify-no-node-transform.mjs --out build/no-node-payload --capabilities transform/no-node/capabilities.json",
    "verify:no-node-capabilities": "node scripts/stapk-verify-capability-contract.mjs --contract build/no-node-payload/api-contract.json --capabilities transform/no-node/capabilities.json"
  },
  "dependencies": {
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "acorn": "8.17.0",
    "parse5": "7.3.0"
  }
}
