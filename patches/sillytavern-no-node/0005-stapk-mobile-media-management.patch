+function extractBackgroundSource(value) {
+    const match = String(value ?? '').match(/^url\((['"]?)(.*?)\1\)$/);
+    return match?.[2] || '';
+}
+
+function isVideoBackground(value) {
+    const source = extractBackgroundSource(value) || String(value ?? '');
+    const path = source.split(/[?#]/, 1)[0].toLowerCase();
+    return VIDEO_BACKGROUND_EXTENSIONS.some(extension => path.endsWith(`.${extension}`));
+}
+
+function applyBackground(url) {
+    const background = $('#bg1');
+    const source = extractBackgroundSource(url);
+    let video = document.getElementById('stapk-video-background');
+
+    if (source && isVideoBackground(source)) {
+        background.css('background-image', 'none');
+        if (!(video instanceof HTMLVideoElement)) {
+            video = document.createElement('video');
+            video.id = 'stapk-video-background';
+            video.autoplay = true;
+            video.muted = true;
+            video.loop = true;
+            video.playsInline = true;
+            background.append(video);
+        }
+        if (video.getAttribute('src') !== source) {
+            video.setAttribute('src', source);
+            video.load();
+        }
+        video.hidden = false;
+        void video.play().catch(error => console.debug('Video background autoplay was blocked:', error));
+        return;
+    }
+
+    if (video instanceof HTMLVideoElement) {
+        video.pause();
+        video.hidden = true;
+        video.removeAttribute('src');
+        video.load();
+    }
+    background.css('background-image', url);
+}
