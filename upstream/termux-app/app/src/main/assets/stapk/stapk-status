#!/data/data/com.stapk.termux/files/usr/bin/bash
# stAPK Status - Check SillyTavern status and output JSON
set -uo pipefail

STAPK_HOME="$HOME/.stapk"
STAPK_STATE="$STAPK_HOME/state"
ST_DIR="$HOME/SillyTavern"

# Read port from config or default
PORT=8000
if [ -f "$ST_DIR/config.yaml" ]; then
    CFG_PORT=$(grep -E '^\s*port\s*:' "$ST_DIR/config.yaml" 2>/dev/null | awk '{print $2}' | tr -d '\r')
    if [ -n "$CFG_PORT" ] && [ "$CFG_PORT" -eq "$CFG_PORT" ] 2>/dev/null; then
        PORT="$CFG_PORT"
    fi
fi

# Check states
INITIALIZED="false"
if [ -f "$STAPK_STATE/initialized" ]; then
    INITIALIZED="true"
fi

# 优先读取托管运行时 PID 文件
RUNTIME_PID_FILE="$STAPK_STATE/runtime-task.pid"
CHILD_PID_FILE="$STAPK_STATE/runtime-child.pid"

RUNTIME_PID=""
RUNTIME_MANAGED="false"
if [ -f "$RUNTIME_PID_FILE" ]; then
    RUNTIME_PID="$(cat "$RUNTIME_PID_FILE" 2>/dev/null || echo "")"
    if [ -n "$RUNTIME_PID" ] && kill -0 "$RUNTIME_PID" 2>/dev/null; then
        RUNTIME_MANAGED="true"
    else
        rm -f "$RUNTIME_PID_FILE"
        RUNTIME_PID=""
    fi
fi

CHILD_PID=""
if [ -f "$CHILD_PID_FILE" ]; then
    CHILD_PID="$(cat "$CHILD_PID_FILE" 2>/dev/null || echo "")"
    if [ -n "$CHILD_PID" ] && ! kill -0 "$CHILD_PID" 2>/dev/null; then
        rm -f "$CHILD_PID_FILE"
        CHILD_PID=""
    fi
fi

# Check for node process
NODE_PID="${CHILD_PID:-}"
if [ -z "$NODE_PID" ]; then
    NODE_PID=$(pgrep -f "node .*server.js" 2>/dev/null | head -1 || echo "")
fi
NODE_RUNNING="false"
if [ -n "$NODE_PID" ]; then
    NODE_RUNNING="true"
fi

# Check TCP port
PORT_LISTENING="false"
if [ "$NODE_RUNNING" = "true" ]; then
    if timeout 1 bash -c "echo >/dev/tcp/127.0.0.1/$PORT" 2>/dev/null; then
        PORT_LISTENING="true"
    fi
fi

# Determine overall status
STATUS="stopped"
if [ "$INITIALIZED" = "false" ]; then
    STATUS="not_initialized"
elif [ "$RUNTIME_MANAGED" = "true" ] && [ "$PORT_LISTENING" = "true" ]; then
    STATUS="running"
elif [ "$RUNTIME_MANAGED" = "true" ]; then
    STATUS="starting"
elif [ "$NODE_RUNNING" = "true" ] && [ "$PORT_LISTENING" = "true" ]; then
    STATUS="running"
elif [ "$NODE_RUNNING" = "true" ]; then
    STATUS="starting"
fi

# Read versions
ST_VERSION="unknown"
ST_COMMIT="unknown"
if [ -f "$ST_DIR/package.json" ]; then
    ST_VERSION=$(grep -o '"version":"[^"]*"' "$ST_DIR/package.json" | head -1 | cut -d'"' -f4 || echo "unknown")
fi
if [ -d "$ST_DIR/.git" ]; then
    ST_COMMIT=$(cd "$ST_DIR" && git rev-parse --short HEAD 2>/dev/null || echo "unknown")
fi

NODE_VER=$(node --version 2>/dev/null || echo "unknown")
NPM_VER=$(npm --version 2>/dev/null || echo "unknown")
GIT_VER=$(git --version 2>/dev/null | awk '{print $3}' || echo "unknown")

cat <<EOF
{
  "status": "$STATUS",
  "initialized": $INITIALIZED,
  "runtime_managed": $RUNTIME_MANAGED,
  "runtime_pid": "${RUNTIME_PID:-}",
  "runtime_child_pid": "${CHILD_PID:-}",
  "node_running": $NODE_RUNNING,
  "node_pid": "${NODE_PID:-}",
  "port": $PORT,
  "port_listening": $PORT_LISTENING,
  "sillytavern_version": "$ST_VERSION",
  "sillytavern_commit": "$ST_COMMIT",
  "node_version": "$NODE_VER",
  "npm_version": "$NPM_VER",
  "git_version": "$GIT_VER"
}
EOF
