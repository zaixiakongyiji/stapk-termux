#!/data/data/com.termux/files/usr/bin/bash
# stAPK Start - Start SillyTavern server
set -uo pipefail

STAPK_HOME="$HOME/.stapk"
STAPK_LOGS="$STAPK_HOME/logs"
STAPK_LOCKS="$STAPK_HOME/locks"
ST_DIR="$HOME/SillyTavern"
LOCK_FILE="$STAPK_LOCKS/start.lock"
LOG_FILE="$STAPK_LOGS/start.log"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"; }

# Check lock
if [ -f "$LOCK_FILE" ]; then
    PID=$(grep -o '"pid":[0-9]*' "$LOCK_FILE" | cut -d: -f2)
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        echo "ALREADY_RUNNING"
        exit 0
    else
        # Stale lock
        mkdir -p "$STAPK_LOGS/stale-locks"
        mv "$LOCK_FILE" "$STAPK_LOGS/stale-locks/start-$(date '+%Y%m%d-%H%M%S').lock"
        log "Moved stale start lock"
    fi
fi

# Create lock
mkdir -p "$STAPK_LOCKS" "$STAPK_LOGS"
cat > "$LOCK_FILE" <<EOF
{
  "operation": "start",
  "pid": $$,
  "created_at": "$(date -u '+%Y-%m-%dT%H:%M:%SZ')",
  "command": "stapk-start"
}
EOF

cleanup() {
    rm -f "$LOCK_FILE"
}
trap cleanup EXIT

# Check initialized
if [ ! -f "$STAPK_HOME/state/initialized" ]; then
    echo "ERROR_NOT_INITIALIZED"
    exit 1
fi

# Check SillyTavern exists
if [ ! -f "$ST_DIR/start.sh" ]; then
    echo "ERROR_START_SH_MISSING"
    exit 1
fi

# 修复 Windows 换行符 (payload 构建时可能被 git autocrlf 污染)
tr -d '\r' < "$ST_DIR/start.sh" > "$ST_DIR/start.sh.tmp" && mv "$ST_DIR/start.sh.tmp" "$ST_DIR/start.sh" 2>/dev/null || true

# Acquire wake lock
termux-wake-lock 2>/dev/null || log "WARNING: termux-wake-lock failed"

# Clear log and start
> "$LOG_FILE"
log "Starting SillyTavern..."

cd "$ST_DIR"
export NODE_ENV=production
bash start.sh >> "$LOG_FILE" 2>&1
EXIT_CODE=$?

# Release wake lock on exit
termux-wake-unlock 2>/dev/null || true

log "SillyTavern exited with code $EXIT_CODE"
echo "EXIT_CODE:$EXIT_CODE"
exit $EXIT_CODE
