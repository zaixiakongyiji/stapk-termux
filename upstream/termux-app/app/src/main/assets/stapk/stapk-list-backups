#!/data/data/com.stapk.termux/files/usr/bin/bash
# stAPK List Backups - List available backup files
set -uo pipefail

STAPK_BACKUPS="$HOME/.stapk/backups"

if [ ! -d "$STAPK_BACKUPS" ]; then
    echo "NO_BACKUPS"
    exit 0
fi

# List backup tarballs sorted by modification time (newest first)
find "$STAPK_BACKUPS" -maxdepth 1 -name "*.tar.gz" -type f -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn \
    | awk '{print $2}' \
    | while read -r f; do
        SIZE=$(stat -c%s "$f" 2>/dev/null || echo "0")
        MTIME=$(stat -c%y "$f" 2>/dev/null | cut -d. -f1)
        BASENAME=$(basename "$f")
        echo "BACKUP|${BASENAME}|${SIZE}|${MTIME}|${f}"
    done

if [ -z "$(find "$STAPK_BACKUPS" -maxdepth 1 -name "*.tar.gz" -type f 2>/dev/null)" ]; then
    echo "NO_BACKUPS"
fi
