<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1A2E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stapk_app_title"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp" />

        <!-- Status Card -->
        <LinearLayout
            android:id="@+id/status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FF16213E"
            android:padding="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/status_indicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="#FF555555" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stapk_status_stopped"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/version_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stapk_version_unknown"
                android:textColor="#FFAAAAAA"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Debug Toggle -->
        <LinearLayout
            android:id="@+id/debug_toggle_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="#FF16213E"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stapk_debug_toggle_title"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/debug_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        <!-- Debug Panel -->
        <LinearLayout
            android:id="@+id/debug_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FF16213E"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stapk_debug_panel_title"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/debug_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stapk_debug_empty"
                android:textColor="#FFCCCCCC"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/debug_copy"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/stapk_debug_copy"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:background="#FF0F3460"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Primary Action Buttons -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/stapk_btn_start"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:background="#FF0F3460"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/stapk_btn_stop"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:background="#FF53354A"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_open"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/stapk_btn_open"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:background="#FF1A5C36"
            android:layout_marginBottom="24dp"
            android:enabled="false" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF333355"
            android:layout_marginBottom="24dp" />

        <!-- Secondary Action Buttons -->
        <Button
            android:id="@+id/btn_update"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/stapk_btn_update"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:background="#FF16213E"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_rollback"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/stapk_btn_rollback"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:background="#FF53354A"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_logs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/stapk_btn_logs"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:background="#FF16213E"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_backup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/stapk_btn_backup"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:background="#FF16213E"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_restore"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/stapk_btn_restore"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:background="#FF16213E"
            android:layout_marginBottom="24dp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Version tap target (hidden terminal entry) -->
        <TextView
            android:id="@+id/app_version_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="stAPK"
            android:textColor="#FF444466"
            android:textSize="11sp"
            android:layout_marginBottom="16dp"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
