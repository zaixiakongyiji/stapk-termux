{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stapk.local/schemas/capability-contract.schema.json",
  "title": "stAPK no-node capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "capabilityId": {
      "enum": [
        "core.settings",
        "core.personas",
        "core.characters",
        "core.groups",
        "core.chats",
        "core.world_info",
        "core.backgrounds",
        "core.files",
        "core.tokenizers",
        "core.data_management",
        "remote.embeddings",
        "remote.image",
        "remote.tts",
        "remote.stt",
        "remote.caption",
        "remote.translation",
        "excluded.extensions",
        "excluded.local_models",
        "excluded.multiuser"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "defaultStatus", "endpointPrefixes", "uiPolicy"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "kind": { "enum": ["core", "external_optional", "excluded"] },
        "defaultStatus": {
          "enum": ["implemented", "external_optional", "unsupported_hidden", "needs_review"]
        },
        "endpointPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/api/[^\\s]+$" }
        },
        "uiPolicy": {
          "enum": ["visible_when_implemented", "visible_when_configured", "hidden"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "core" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "id": { "type": "string", "pattern": "^core\\." },
              "defaultStatus": { "enum": ["implemented", "needs_review"] },
              "uiPolicy": { "const": "visible_when_implemented" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "external_optional" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "id": { "type": "string", "pattern": "^remote\\." },
              "defaultStatus": { "const": "external_optional" },
              "uiPolicy": { "const": "visible_when_configured" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "excluded" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "id": { "type": "string", "pattern": "^excluded\\." },
              "defaultStatus": { "const": "unsupported_hidden" },
              "uiPolicy": { "const": "hidden" }
            }
          }
        }
      ]
    }
  }
}
